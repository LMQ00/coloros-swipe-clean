<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:name=".SwipeCleanApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SwipeClean">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hook 侧（system_server，uid 1000）经 call() 拉取配置；authority 必须与 Config.AUTHORITY 一致。 -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="io.github.lmq00.swipeclean.config"
            android:exported="true" />
    </application>

</manifest>